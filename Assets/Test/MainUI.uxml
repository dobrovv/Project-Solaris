<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Test/MainUI.uss?fileID=7433441132597879392&amp;guid=f48ce707622d8964da55d740af36bec1&amp;type=3#MainUI"/>
    <ui:VisualElement name="root" class="root">

        <!-- TOP BAR -->
        <ui:VisualElement class="topbar">
            <ui:VisualElement class="brand-lockup">
                <ui:VisualElement class="brand-mark"/>
                <ui:Label text="SOLARIS" class="brand-title"/>
            </ui:VisualElement>
            <ui:VisualElement class="status-lockup">
                <ui:VisualElement class="status-dot"/>
                <ui:Label text="ONLINE  /  BUILD 01" class="status-text"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- MAIN PAGE -->
        <ui:VisualElement name="main-page" class="page main-page">
            <ui:VisualElement class="eyebrow-row">
                <ui:VisualElement class="eyebrow-line"/>
                <ui:Label text="STRATEGIC COMMAND" class="eyebrow"/>
            </ui:VisualElement>
            <ui:Label text="CONQUER" class="hero-title"/>
            <ui:Label text="THE STARS" class="hero-title hero-title-accent"/>
            <ui:Label text="Choose how you want to begin your campaign." class="hero-subtitle"/>
            <ui:VisualElement class="main-menu-buttons">
                <ui:Button name="campaign-button" text="CAMPAIGN" class="menu-button primary-button"/>
                <ui:Button name="skirmish-button" text="SKIRMISH" class="menu-button secondary-button"/>
            </ui:VisualElement>
            <ui:Label text="EXPAND  •  CONTROL  •  CONQUER" class="main-page-footer"/>
        </ui:VisualElement>

        <!-- CAMPAIGN PAGE -->
        <ui:VisualElement name="campaign-page" class="page content-page page-hidden">
            <ui:VisualElement class="content-panel campaign-panel">
                <ui:VisualElement class="eyebrow-row">
                    <ui:VisualElement class="eyebrow-line"/>
                    <ui:Label text="CAMPAIGN" class="eyebrow"/>
                </ui:VisualElement>
                <ui:Label text="SELECT OPERATION" class="section-title"/>
                <ui:Label text="Choose one of the 30 campaign missions." class="section-subtitle"/>

                <ui:ScrollView name="level-scroll" class="level-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" mouse-wheel-scroll-size="60">

                    <!-- SECTOR ALPHA -->
                    <ui:VisualElement class="chapter-header">
                        <ui:Label text="SECTOR ALPHA" class="chapter-title"/>
                        <ui:VisualElement class="chapter-line"/>
                        <ui:Label text="01 - 10" class="chapter-range"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="level-grid">
                        <ui:Button name="level-1" text="01" class="level-button"/>
                        <ui:Button name="level-2" text="02" class="level-button"/>
                        <ui:Button name="level-3" text="03" class="level-button"/>
                        <ui:Button name="level-4" text="04" class="level-button"/>
                        <ui:Button name="level-5" text="05" class="level-button"/>
                        <ui:Button name="level-6" text="06" class="level-button"/>
                        <ui:Button name="level-7" text="07" class="level-button"/>
                        <ui:Button name="level-8" text="08" class="level-button"/>
                        <ui:Button name="level-9" text="09" class="level-button"/>
                        <ui:Button name="level-10" text="10" class="level-button boss"/>
                    </ui:VisualElement>

                    <!-- SECTOR BETA -->
                    <ui:VisualElement class="chapter-header">
                        <ui:Label text="SECTOR BETA" class="chapter-title"/>
                        <ui:VisualElement class="chapter-line"/>
                        <ui:Label text="11 - 20" class="chapter-range"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="level-grid">
                        <ui:Button name="level-11" text="11" class="level-button"/>
                        <ui:Button name="level-12" text="12" class="level-button"/>
                        <ui:Button name="level-13" text="13" class="level-button"/>
                        <ui:Button name="level-14" text="14" class="level-button"/>
                        <ui:Button name="level-15" text="15" class="level-button"/>
                        <ui:Button name="level-16" text="16" class="level-button"/>
                        <ui:Button name="level-17" text="17" class="level-button"/>
                        <ui:Button name="level-18" text="18" class="level-button"/>
                        <ui:Button name="level-19" text="19" class="level-button"/>
                        <ui:Button name="level-20" text="20" class="level-button boss"/>
                    </ui:VisualElement>

                    <!-- SECTOR GAMMA -->
                    <ui:VisualElement class="chapter-header">
                        <ui:Label text="SECTOR GAMMA" class="chapter-title"/>
                        <ui:VisualElement class="chapter-line"/>
                        <ui:Label text="21 - 30" class="chapter-range"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="level-grid">
                        <ui:Button name="level-21" text="21" class="level-button"/>
                        <ui:Button name="level-22" text="22" class="level-button"/>
                        <ui:Button name="level-23" text="23" class="level-button"/>
                        <ui:Button name="level-24" text="24" class="level-button"/>
                        <ui:Button name="level-25" text="25" class="level-button"/>
                        <ui:Button name="level-26" text="26" class="level-button"/>
                        <ui:Button name="level-27" text="27" class="level-button"/>
                        <ui:Button name="level-28" text="28" class="level-button"/>
                        <ui:Button name="level-29" text="29" class="level-button"/>
                        <ui:Button name="level-30" text="30" class="level-button boss"/>
                    </ui:VisualElement>

                </ui:ScrollView>

                <ui:VisualElement class="selection-bar">
                    <ui:Label name="campaign-selection-label" text="NO LEVEL SELECTED" class="selection-status"/>
                </ui:VisualElement>
                <ui:VisualElement class="panel-actions">
                    <ui:Button name="campaign-back-button" text="BACK" class="secondary-button action-button"/>
                    <ui:Button name="campaign-start-button" text="BEGIN CAMPAIGN" class="primary-button action-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- SKIRMISH PAGE -->
        <ui:VisualElement name="skirmish-page" class="page content-page page-hidden">
            <ui:VisualElement class="content-panel skirmish-panel">
                <ui:VisualElement class="eyebrow-row">
                    <ui:VisualElement class="eyebrow-line"/>
                    <ui:Label text="CUSTOM BATTLE" class="eyebrow"/>
                </ui:VisualElement>
                <ui:Label text="SKIRMISH SETUP" class="section-title"/>
                <ui:Label text="Configure the battlefield and opposing forces." class="section-subtitle"/>

                <ui:VisualElement class="settings-list">
                    <ui:VisualElement class="setting-row">
                        <ui:VisualElement class="setting-copy">
                            <ui:Label text="MAP SIZE" class="setting-title"/>
                            <ui:Label text="Scale of the star map" class="setting-description"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="choice-buttons">
                            <ui:Button name="map-small" text="SMALL" class="option-button"/>
                            <ui:Button name="map-medium" text="MEDIUM" class="option-button selected"/>
                            <ui:Button name="map-large" text="LARGE" class="option-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="setting-row">
                        <ui:VisualElement class="setting-copy">
                            <ui:Label text="AI STRENGTH" class="setting-title"/>
                            <ui:Label text="Opponent difficulty" class="setting-description"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="choice-buttons">
                            <ui:Button name="ai-easy" text="EASY" class="option-button"/>
                            <ui:Button name="ai-normal" text="NORMAL" class="option-button selected"/>
                            <ui:Button name="ai-hard" text="HARD" class="option-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="setting-row">
                        <ui:VisualElement class="setting-copy">
                            <ui:Label text="OPPONENTS" class="setting-title"/>
                            <ui:Label text="Number of enemy factions" class="setting-description"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="choice-buttons opponent-choices">
                            <ui:Button name="opponents-1" text="1" class="option-button"/>
                            <ui:Button name="opponents-2" text="2" class="option-button selected"/>
                            <ui:Button name="opponents-3" text="3" class="option-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="panel-actions">
                    <ui:Button name="skirmish-back-button" text="BACK" class="secondary-button action-button"/>
                    <ui:Button name="skirmish-start-button" text="START MATCH" class="primary-button action-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>

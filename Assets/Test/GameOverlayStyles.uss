:root {
}

.button {
    font-size: 20px;
    -unity-font-style: bold;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    width: 330px;
    height: 70px;
    align-items: flex-start;
    justify-content: flex-start;
    align-self: center;
    align-content: center;
    margin-bottom: 25px;
    margin-top: 25px;
}

.margin {
    margin-top: 0;
    margin-bottom: 25px;
}

.sized-elem {
    background-size: 100% 100%;
    width: 75%;
    margin-left: 0;
    margin-right: 0;
    font-size: 50px;
    margin-bottom: 2%;
    margin-top: 2%;
    align-items: center;
    height: 15%;
}

.speed-button {
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 10px;
    color: rgb(143, 156, 174);
    justify-content: space-around;
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgb(0, 0, 0);
    width: 30px;
    height: 30px;
    transition-duration: 0.35s;
}

.speed-button:hover {
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.098);
}

.speed-button-selected {
    font-size: 10px;
    background-color: rgb(79, 209, 255);
    color: rgb(0, 0, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(143, 156, 174, 0.475);
    border-right-color: rgba(143, 156, 174, 0.475);
    border-top-color: rgba(143, 156, 174, 0.475);
    border-bottom-color: rgba(143, 156, 174, 0.475);
}

.speed-button-selected Image {
    --unity-image-tint-color: rgb(0, 0, 0);
    -unity-background-image-tint-color : rgb(0, 0, 0);
}

.speed-button-selected:hover {
    -unity-font-style: normal;
    font-size: 10px;
    background-color: rgb(88, 228, 198);
    color: rgb(0, 0, 0);
}
